# ==============================================================================
# Dockerfile.dockerignore — pycaffe-customer 专用构建上下文排除规则
# 当使用 BuildKit 构建时（DOCKER_BUILDKIT=1），此文件自动覆盖 vendor/.dockerignore
# 构建命令 (在 vendor/ 目录执行):
#   DOCKER_BUILDKIT=1 docker build -t caffe-cpu:customer \
#       -f caffe/docker/standalone/pycaffe-customer/Dockerfile .
# ==============================================================================

# Git
**/.git/
**/.gitignore
**/.gitattributes
**/.gitmodules

# IDE / 编辑器
**/.vscode/
**/.idea/
**/.trae/
**/.specify/
**/.codebuddy/
*.swp
*.swo
*~

# Python 缓存
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.egg-info/
**/*.egg
**/.eggs/
**/dist/
**/build/
**/*.whl

# Jupyter 缓存
**/.ipynb_checkpoints/

# CMake 构建产物 (但允许 docker/standalone/ 下的源文件)
caffe/caffe-slim/build*/
caffe/caffe-slim/CMakeCache.txt
caffe/caffe-slim/CMakeFiles/
tvm-ffi/build*/
tvm-ffi/CMakeCache.txt
tvm-ffi/CMakeFiles/

# Docker 其他目录（排除构建文件，但保留 pycaffe-jupyter-ssh/examples/ 下的模型文件）
caffe/docker/local/
caffe/docker/standalone/pycaffe/
caffe/docker/standalone/pycaffe-jupyter-ssh/Dockerfile
caffe/docker/standalone/pycaffe-jupyter-ssh/build.sh
caffe/docker/standalone/pycaffe-jupyter-ssh/run.sh
caffe/docker/standalone/pycaffe-jupyter-ssh/sshd_config
caffe/docker/standalone/pycaffe-jupyter-ssh/supervisord.conf
caffe/docker/standalone/pycaffe-jupyter-ssh/jupyter_notebook_config.py
caffe/docker/standalone/pycaffe-jupyter-ssh/entrypoint.sh
caffe/docker/standalone/pycaffe-jupyter-ssh/config/
caffe/docker/standalone/pycaffe-jupyter-ssh/scripts/
caffe/docker/standalone/pycaffe-jupyter-ssh/patch-*/
!caffe/docker/standalone/pycaffe-jupyter-ssh/examples/

# pycaffe-customer 自身目录：只保留构建需要的文件
caffe/docker/standalone/pycaffe-customer/build.sh
caffe/docker/standalone/pycaffe-customer/export.sh
caffe/docker/standalone/pycaffe-customer/build-and-export.sh
caffe/docker/standalone/pycaffe-customer/build.ps1
caffe/docker/standalone/pycaffe-customer/explore_api*.py
caffe/docker/standalone/pycaffe-customer/TROUBLESHOOTING.md
caffe/docker/standalone/pycaffe-customer/AGENTS.md
caffe/docker/standalone/pycaffe-customer/.agents/
caffe/docker/standalone/pycaffe-customer/dist/
caffe/docker/standalone/pycaffe-customer/Dockerfile.dockerignore

# 文档（保留 README.md）
*.md
!README.md
!caffe/docker/standalone/pycaffe-customer/README.md

# 媒体/数据文件（但允许我们需要的示例文件）
**/*.jpg
**/*.jpeg
**/*.gif
**/*.bmp
**/*.tiff
**/*.h5
**/*.hdf5
**/*.solverstate
**/*.binaryproto
**/*.npy
**/*.npz
**/*.tar
**/*.tar.gz
**/*.tgz
**/*.zip
!caffe/docker/standalone/pycaffe-jupyter-ssh/examples/resnet50/data/demo.png
!caffe/docker/standalone/pycaffe-jupyter-ssh/examples/resnet50/ResNet-50-model.caffemodel
!caffe/docker/standalone/pycaffe-jupyter-ssh/examples/resnet50/ResNet-50-deploy.prototxt
!caffe/docker/standalone/pycaffe-jupyter-ssh/examples/infer.py

# 日志
**/*.log

# 临时文件
**/tmp/
**/temp/
**/*.tmp
**/*.bak

# 3rdparty 中不需要的内容
tvm-ffi/3rdparty/dlpack/docs/
tvm-ffi/3rdparty/libbacktrace/.git/
tvm-ffi/3rdparty/dlpack/.git/

# caffex (零依赖铁律)
caffe/caffex/

# patch 目录
**/patch-*/

# 本地 conda 环境
caffe/docker/local/conda/build/

# OS 文件
.DS_Store
Thumbs.db
desktop.ini
