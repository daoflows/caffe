# ==============================================================================
# 客户分发镜像 Dockerfile 模板
# ==============================================================================
# 用途：基于已有Jupyter镜像构建自包含客户分发包，解决VOLUME目录文件预置问题
# 用法：
#   1. 复制为 Dockerfile.customer
#   2. 修改 FROM 基础镜像名
#   3. 修改 LABEL 信息
#   4. 修改 ENV 默认密码/Token
#   5. 修改 COPY 源文件和目标路径
#   6. 修改 ENTRYPOINT 为你的wrapper脚本
# ==============================================================================

FROM __BASE_IMAGE__

LABEL version="1.0.0"
LABEL description="__PRODUCT__-customer-self-contained"
LABEL built="__BUILD_DATE__"

# 默认凭据（客户可通过 docker run -e 覆盖）
ENV USER_PASSWORD=__DEFAULT_PASSWORD__
ENV JUPYTER_TOKEN=__DEFAULT_TOKEN__
ENV GRANT_SUDO=yes

# ---- 关键设计 ----
# 文件不直接 COPY 到 VOLUME 路径（如 /workspace），因为 VOLUME 目录的内容
# 不会被 docker commit 保存。这里将预置文件放在非VOLUME路径，由 entrypoint
# wrapper 在容器首次启动时复制到工作目录。
COPY __PRESET_FILE__ /opt/__PRODUCT__-examples/__PRESET_FILE__
RUN chmod 644 /opt/__PRODUCT__-examples/__PRESET_FILE__

# 复制 entrypoint wrapper 脚本
COPY entrypoint-__PRODUCT__.sh /usr/local/bin/entrypoint-__PRODUCT__.sh
RUN chmod +x /usr/local/bin/entrypoint-__PRODUCT__.sh

# 使用 tini 作为 PID 1，确保信号正确传递
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint-__PRODUCT__.sh"]
CMD []
